---
/**
 * Callout Component
 * 
 * For highlighting important information, warnings, tips, etc.
 * 
 * Usage in MDX:
 * <Callout type="tip">
 *   This is a helpful tip!
 * </Callout>
 * 
 * <Callout type="warning">
 *   Watch out for this gotcha.
 * </Callout>
 */
export interface Props {
  type?: "tip" | "warning" | "info" | "danger";
  title?: string;
}

const { type = "info", title } = Astro.props;

const styles = {
  tip: {
    bg: "bg-neural-50",
    border: "border-neural-400",
    icon: "",
    text: "text-slate-800",
    defaultTitle: "Tip",
  },
  warning: {
    bg: "bg-glow-50",
    border: "border-glow-500",
    icon: "",
    text: "text-slate-800",
    defaultTitle: "Warning",
  },
  info: {
    bg: "bg-quantum-50",
    border: "border-quantum-400",
    icon: "",
    text: "text-slate-800",
    defaultTitle: "Note",
  },
  danger: {
    bg: "bg-aurora-50",
    border: "border-aurora-400",
    icon: "",
    text: "text-slate-800",
    defaultTitle: "Danger",
  },
};

const style = styles[type];
const displayTitle = title || style.defaultTitle;
---

<aside class={`callout not-prose my-6 p-4 ${style.bg} rounded-lg border-l-2 ${style.border}`}>
  <div class="flex items-center gap-2 mb-2">
    <span class={`font-semibold text-sm uppercase tracking-wide ${style.text}`}>{displayTitle}</span>
  </div>
  <div class={`text-sm ${style.text}`}>
    <slot />
  </div>
</aside>
