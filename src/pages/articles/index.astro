---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, DIFFICULTIES } from "@/config";

// Get all published Archives posts (debug-agent has its own hub), sorted by date
const allPosts = await getCollection("blog", ({ data }) => !data.draft && data.project !== "debug-agent");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<MainLayout title="Blog | BlueRobin Tech Blog" description="All articles on .NET, Kubernetes, LLM integration, and Domain-Driven Design">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <p class="text-sm font-medium text-neural-400 mb-2">
        <a href="/archives/" class="hover:underline">Project · The Archives</a>
      </p>
      <h1 class="text-3xl sm:text-4xl font-display font-semibold title-blue mb-4">
        All Articles
      </h1>
      <p class="text-lg text-slate-600">
        Deep dives, cookbooks, and implementation guides from <strong class="text-slate-700">the Archives</strong> — BlueRobin's document-intelligence platform.
      </p>
    </header>

    <!-- Browse by Category -->
    <section class="mb-12">
      <h2 class="text-2xl font-display font-semibold text-slate-900 mb-6">
        Browse by Category
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {Object.entries(CATEGORIES).map(([key, cat]) => {
          const borderColor = {
            neural: "border-neural-400",
            complement: "border-complement-400",
            aurora: "border-aurora-400",
            glow: "border-glow-400",
          }[cat.color] ?? "border-neural-400";
          return (
            <a href={`/${key}/`} class={`glass-card p-5 transition-all border-l-4 ${borderColor}`}>
              <h3 class="font-medium text-slate-800 mb-1">{cat.title}</h3>
              <p class="text-sm text-slate-600">{cat.description}</p>
            </a>
          );
        })}
      </div>
    </section>

    {sortedPosts.length === 0 ? (
      <div class="glass-card p-12 text-center">
          <p class="text-slate-600 text-lg">
          Articles coming soon. The first article in the DDD series is being prepared.
        </p>
      </div>
    ) : (
      <div class="space-y-6">
        {sortedPosts.map((post) => {
          const categoryMeta = CATEGORIES[post.data.category];
          const difficultyMeta = DIFFICULTIES[post.data.difficulty];

          return (
            <article class="glass-card p-6 hover:shadow-lg transition-all">
              <div class="flex flex-col md:flex-row md:items-start gap-4">
                <div class="flex-1">
                  <a href={`/articles/${post.slug}/`}>
                    <h2 class="text-xl font-medium text-slate-800 hover:text-neural-400 transition-colors mb-2">
                      {post.data.title}
                    </h2>
                  </a>
                  
                  <p class="text-slate-600 mb-3 line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                
                <div class="text-sm text-slate-600 md:text-right space-y-1">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  {post.data.readTime && (
                    <p class="text-xs">{post.data.readTime}</p>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</MainLayout>
