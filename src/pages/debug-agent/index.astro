---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, DIFFICULTIES } from "@/config";
import DebugAgentRcaDiagram from "@components/DebugAgentRcaDiagram.astro";

// The Debug Agent project's articles (the ArXiv-style papers)
const papers = (await getCollection("blog", ({ data }) => !data.draft && data.project === "debug-agent"))
  .sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

// The five research themes (each maps to a paper). Used as teasers when a paper
// is not yet published, and as section copy.
const themes = [
  {
    n: "01",
    title: "The StackGraph",
    blurb:
      "A persistent neuro-symbolic world-model in FalkorDB that fuses code, infra, runtime telemetry, change history and past RCA outcomes into one property graph the agent reasons over.",
    tags: ["FalkorDB", "Property graph", "Neuro-symbolic"],
    variant: "complement",
  },
  {
    n: "02",
    title: "Correlation-first blame propagation",
    blurb:
      "Personalized PageRank over an error-weighted dependency graph, blended with parameter-free BOCPD change-point scoring (BARO) — deterministic graph priors that seed the LLM's hypothesis space. No causal discovery.",
    tags: ["PageRank", "BOCPD / BARO", "Change-point"],
    variant: "neural",
  },
  {
    n: "03",
    title: "Don't grade your own homework",
    blurb:
      "An externalized verification-gate FSM governs loop termination; hypothesis state is derived only from hard tool evidence (never LLM-asserted); a grounding-based soft-cap keeps thin conclusions below the auto-PR tier.",
    tags: ["MAST", "Verification gate", "Hypothesis tree"],
    variant: "complement",
  },
  {
    n: "04",
    title: "Eval-first agentic RCA",
    blurb:
      "Every change passes a deterministic AC@1 / MTTR replay gate with distractor injection, behind a shadow → active rollout — so an LLM-in-the-loop system ships safely against a labelled ground-truth set.",
    tags: ["AC@1 / MTTR", "Regression gate", "Shadow→active"],
    variant: "glow",
  },
  {
    n: "05",
    title: "Bi-temporal incident memory",
    blurb:
      "A hand-rolled Graphiti-on-FalkorDB temporal knowledge graph with no-LLM-at-retrieval hybrid recall (semantic + BM25 + graph-BFS, fused by RRF) and Reflexion-style lessons — the agent learns from every incident.",
    tags: ["Temporal KG", "RRF recall", "Reflexion"],
    variant: "complement",
  },
];

// The four-step investigation pipeline. Each step carries its own accent tokens
// (tint / hover-ring / number color) so the cards stay on-brand per stage.
const steps = [
  {
    n: 1,
    title: "Detect",
    blurb: "An Alertmanager webhook is de-duplicated, then deterministic passes gather traces, logs and code context before any model call.",
    tint: "--color-complement-alpha-10",
    ring: "--color-complement-alpha-20",
    num: "--color-complement-300",
  },
  {
    n: 2,
    title: "Recall & rank",
    blurb: "Personalized PageRank + BARO change-point scoring rank candidate causes; hybrid memory recalls related past incidents — all without an LLM.",
    tint: "--color-neural-alpha-10",
    ring: "--color-neural-alpha-20",
    num: "--color-neural-400",
  },
  {
    n: 3,
    title: "Investigate",
    blurb: "A bounded ReAct loop queries real tools. A verification-gate FSM — not the model — decides when evidence is sufficient to stop.",
    tint: "--color-glow-alpha-10",
    ring: "--color-glow-alpha-20",
    num: "--color-glow-700",
  },
  {
    n: 4,
    title: "Decide",
    blurb: "A confidence ladder, soft-capped by graph grounding, chooses the action: notify, open an issue, attach patches, or open a PR for a human.",
    tint: "--color-complement-alpha-10",
    ring: "--color-complement-alpha-20",
    num: "--color-complement-300",
  },
];

// Tech stack with inline brand marks (monochrome, currentColor so they read
// white on the gradient pills). Brand logos via Simple Icons; FalkorDB / Tempo /
// Loki have no monochrome brand glyph, so they use functional marks
// (graph nodes / trace waterfall / log lines).
const stack = [
