    /* Research ideas roster */
    .da-idea { display: flex; gap: 0.85rem; align-items: flex-start; padding: 1.1rem 1.4rem; }
    .da-idea-n { font-family: ui-monospace, monospace; font-size: 0.85rem; font-weight: 600; color: var(--color-complement-300); flex-shrink: 0; padding-top: 0.1rem; }
    .da-idea-title { font-family: var(--font-display, inherit); font-weight: 600; color: #1e293b; font-size: 0.98rem; }
    .da-idea-blurb { font-size: 0.8rem; color: #64748b; line-height: 1.5; margin-top: 0.2rem; }
    .da-idea-tag {
      font-size: 0.68rem;
      padding: 0.05rem 0.45rem;
      border-radius: 999px;
      background: var(--color-complement-alpha-10);
      color: var(--color-complement-300);
      border: 1px solid var(--color-complement-alpha-20);
    }

    /* Scenario tabs */
    .da-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }
    .da-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.55rem 1.1rem;
      border-radius: 0.85rem;
      background: rgba(255, 255, 255, 0.55);
      border: 1px solid var(--color-complement-alpha-20);
      color: #475569;
      font-weight: 600;
      line-height: 1.15;
      cursor: pointer;
      transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
    }
    .da-tab svg { color: #b08968; transition: color 0.18s ease; }
    .da-tab:hover { border-color: var(--color-complement-alpha-30); color: #1e293b; }
    .da-tab .da-tab-sub {
      display: block;
      font-size: 0.68rem;
      font-weight: 500;
      color: #94a3b8;
      font-family: ui-monospace, monospace;
      margin-top: 0.1rem;
    }
    .da-tab[aria-selected="true"] {
      background: var(--gradient-complement);
      border-color: transparent;
      color: #fff;
    }
    .da-tab[aria-selected="true"] svg,
    .da-tab[aria-selected="true"] .da-tab-sub { color: rgba(255, 255, 255, 0.82); }
    .da-tab:focus-visible { outline: 2px solid var(--color-complement-300); outline-offset: 2px; }

    /* Scenario panels */
    .da-panel[hidden] { display: none; }
    .da-panel { animation: da-fade 0.3s ease; }
    @keyframes da-fade {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .da-panel { animation: none; }
    }
  </style>

  <script>
    const daTablist = document.querySelector(".da-tabs");
    if (daTablist) {
      const tabs = Array.from(daTablist.querySelectorAll('[role="tab"]'));
      const selectTab = (tab: Element) => {
        tabs.forEach((t) => {
          const selected = t === tab;
          t.setAttribute("aria-selected", String(selected));
          (t as HTMLElement).tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(t.getAttribute("aria-controls") || "");
          if (panel) (panel as HTMLElement).hidden = !selected;
        });
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => selectTab(tab));
        tab.addEventListener("keydown", (e) => {
          const key = (e as KeyboardEvent).key;
          if (key === "ArrowRight" || key === "ArrowLeft") {
            e.preventDefault();
            const dir = key === "ArrowRight" ? 1 : -1;
            const next = tabs[(i + dir + tabs.length) % tabs.length] as HTMLElement;
            next.focus();
            selectTab(next);
          }
        });
      });
    }
  </script>
</MainLayout>
