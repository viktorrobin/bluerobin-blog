---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// All leadership posts incl. drafts, so cards reflect real state:
//   published (!draft) -> "Read" (links)   draft stub -> "Draft"   neither -> "Planned"
const all = await getCollection("blog", ({ data }) => data.project === "leadership");
const published = new Set(all.filter((p) => !p.data.draft).map((p) => p.slug));
const drafted = new Set(all.filter((p) => p.data.draft).map((p) => p.slug));

// Curated catalog. Each essay opens with a mistake I made, then what it taught me,
// what I changed, and what happened — in the spirit of Will Larson's "An Elegant
// Puzzle." Titles name the practice; the mistake lives in the opening line.
const essays = [
  // — Diagnosing & shaping teams —
  { slug: "four-states-explicit-contracts-org-turnaround", title: "Diagnosing a Stuck Team with the Four States", blurb: "The quarter I read flat velocity as a headcount problem — and learned it was a clarity problem, not a capacity one.", puzzle: "The four states" },
  { slug: "org-design-across-continents-distributed-teams", title: "Running a Reorg Around Domain Boundaries", blurb: "Organising teams for convenience, then watching cross-zone decisions take days. The reorg around domain boundaries — and Conway's Law — that fixed it.", puzzle: "Running a reorg" },
  { slug: "sizing-teams-copilot-era", title: "Sizing Teams in the Copilot Era", blurb: "Assuming AI assistants meant smaller teams and linear output — and discovering the bottleneck just moved to review and context.", puzzle: "Sizing teams" },
  { slug: "career-ladders-across-cultures", title: "Designing a Career Ladder for Senior ICs", blurb: "Losing strong engineers because the only ladder ran through management — and building an IC track, with explicit regional expectations, that held.", puzzle: "Career ladders" },
  // — Culture & trust —
  { slug: "low-drama-engineering-culture", title: "Building a Low-Drama Engineering Team", blurb: "Tolerating a high performer's toxic behaviour because the output was good. The math was negative — culture is what you tolerate.", puzzle: "Culture & values" },
  { slug: "no-news-good-news-trust", title: "No News Is Good News: Leading With Trust, Not Status", blurb: "Chasing status updates to feel in control — and learning that trust-by-default, with the right signals, ships more.", puzzle: "Autonomy & trust" },
  { slug: "on-call-blamelessness-incident-culture-hiring", title: "Building a Blameless On-Call", blurb: "The postmortem that drifted toward 'who broke it', what it cost, and rebuilding on-call into something engineers want to join.", puzzle: "On-call & operational excellence" },
  // — Focus & delivery —
  { slug: "reducing-wip-finishing-beats-starting", title: "Reducing WIP: Why Finishing Beats Starting", blurb: "A team that looked busy and shipped little. Limiting work in progress — not adding people — fixed throughput.", puzzle: "Systems thinking" },
  { slug: "shipping-velocity-technical-debt-four-states", title: "Managing to Cycle Time, Not Velocity", blurb: "Chasing a story-point target until quality slipped. Measuring cycle time and stability instead, and letting velocity follow.", puzzle: "Metrics & baselines" },
  { slug: "protecting-teams-saying-no", title: "Protecting Your Team by Learning to Say No", blurb: "Saying yes to everything to be helpful — and passing the thrash straight to the team. Becoming a filter, not a funnel.", puzzle: "Saying no" },
  { slug: "distributed-observability-substitute-for-synchrony", title: "Replacing Status Meetings with Observability", blurb: "The standing meeting that ate hours and decided nothing — replaced with team-health dashboards and an async protocol.", puzzle: "Shared context" },
  // — Product, roadmap & cross-functional —
  { slug: "engineering-product-partnership", title: "Building a Real Engineering–Product Partnership", blurb: "Letting engineering settle into an order-taker relationship with product — and rebuilding it into shared ownership of outcomes.", puzzle: "Stakeholder partnership" },
  { slug: "engineering-investment-product-roadmap", title: "Fitting Engineering Investment Into a Product Roadmap", blurb: "Letting 'tech debt later' lose every call against features — until it forced an expensive reckoning. Making it a planned, sized line.", puzzle: "Managing technical quality" },
  { slug: "cross-team-features-incremental-milestones", title: "Aligning Cross-Team Features With Incremental Milestones", blurb: "Coordinating a cross-team feature around one big-bang date. Dependency-aware, incremental milestones fixed the slips.", puzzle: "Program sequencing" },
  { slug: "migrations-only-scalable-change-strangler-fig-org", title: "Migrations, Not Rewrites: The Only Change That Scales", blurb: "The rewrite I nearly committed to, and why strangler-fig migrations became my default for changing a codebase — and an org.", puzzle: "Migrations" },
  // — Scaling knowledge —
  { slug: "knowledge-codification-ask-the-system", title: "Removing Yourself as the Onboarding Bottleneck", blurb: "Being the person everyone routed questions to — and turning runbooks, ADRs and retros into something the team could query instead.", puzzle: "Hiring & onboarding" },
];
---

<MainLayout
  title="Leadership | BlueRobin"
  description="Essays on engineering leadership — team turnaround, org design, hiring, on-call, working with product, protecting focus, and shipping cross-functional work. Each starts with a mistake I made, grounded in Will Larson's An Elegant Puzzle."
>
  <!-- Breadcrumb -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <a href="/" class="text-sm text-slate-600 hover:text-neural-400 transition-colors">← All projects</a>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: var(--gradient-mesh-light);">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-neural-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-complement-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1.2s;"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10 sm:pt-24 text-center animate-entry">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-7" style="background: var(--color-neural-alpha-10); border: 1px solid var(--color-neural-alpha-20); color: var(--color-neural-400);">
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--color-complement-400);"></span>
        Director's notes
      </div>
      <h1 class="text-4xl sm:text-5xl font-display font-bold mb-5 leading-tight tracking-tight">
        <span class="title-blue">Notes on</span> <span class="title-warm">engineering leadership.</span>
      </h1>
      <p class="text-lg text-slate-600">
        The rest of this site is about the engineering; these essays are about leading it.
        Each one starts where the learning actually did — with a mistake I made — then works
        through what it taught me, what I changed, and what happened. They lean on concepts from
        Will Larson's <em>An Elegant Puzzle</em> and on leading engineering teams, with BlueRobin
        as the small-scale lab where the same disciplines show up first.
      </p>
    </div>
  </section>

  <!-- Essays -->
  <section class="relative py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {essays.map((e) => {
          const isPublished = published.has(e.slug);
          const isDraft = !isPublished && drafted.has(e.slug);
          const status = isPublished ? "Read" : isDraft ? "Draft" : "Planned";
          const Tag = isPublished ? "a" : "div";
          return (
            <Tag
              href={isPublished ? `/leadership/${e.slug}/` : undefined}
              class={`glass-card p-7 flex flex-col ${isPublished ? "group transition-transform hover:-translate-y-1" : ""}`}
            >
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full" style={`background: var(--color-neural-alpha-10); color: var(--color-neural-400); border: 1px solid var(--color-neural-alpha-20);`}>{e.puzzle}</span>
                <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full shrink-0 ${isPublished ? "text-complement-500" : "text-slate-500"}`} style={isPublished ? "background: var(--color-complement-alpha-10); border: 1px solid var(--color-complement-alpha-20);" : "background: rgba(15,23,42,0.04);"}>{status}</span>
              </div>
              <h2 class="text-lg font-display font-semibold text-slate-900 mb-2">{e.title}</h2>
              <p class="text-sm text-slate-600 leading-relaxed">{e.blurb}</p>
              {isPublished && (
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-neural-400">
                  Read the essay
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              )}
            </Tag>
          );
        })}
      </div>
      <p class="text-center text-sm text-slate-500 mt-8">
        Reference: <em>An Elegant Puzzle — Systems of Engineering Management</em>, Will Larson.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-14" style="background: var(--gradient-mesh-light);">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-display font-semibold text-slate-900 mb-4">Leadership, grounded in practice</h2>
      <p class="text-slate-600 mb-8">
        These notes sit alongside the measurable delivery documented across the rest of the site.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/impact/" class="btn-primary">See the impact</a>
        <a href="/" class="btn-secondary">Explore the projects</a>
      </div>
    </div>
  </section>
</MainLayout>
