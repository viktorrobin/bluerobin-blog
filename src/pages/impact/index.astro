---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// Keep the headline counts honest — derive what we can from the content itself.
const posts = await getCollection("blog", ({ data }) => !data.draft);
const paperCount = posts.filter((p) => p.data.project === "debug-agent").length;
const articleCount = posts.length;

// Outcome cards. Every metric is sourced from a real published article — the
// `href` points at the deep-dive so a reviewer can verify the claim.
const metrics = [
  {
    metric: "95%",
    unit: "faster",
    label: "End-to-end latency",
    detail:
      "60s → 3s on document Q&A. Sequential HTTP calls replaced with parallel NATS requests, Redis caching, and tuned Qdrant vector search.",
    href: "/articles/latency-revolution-optimizing-60s-to-3s/",
    cta: "Read the latency story",
    accent: "--color-neural-500",
  },
  {
    metric: "20×",
    unit: "throughput",
    label: "Ingestion pipeline",
    detail:
      "12 → 250 documents/minute through the agent pipeline, while database CPU dropped from 85% to 15% under load.",
    href: "/articles/latency-revolution-optimizing-60s-to-3s/",
    cta: "See how",
    accent: "--color-complement-500",
  },
  {
    metric: "€50",
    unit: "/ month",
    label: "Whole-platform cost ceiling",
    detail:
      "Five LLM providers plus a 2-node K3s cluster kept under a hard monthly budget via model-policy governance and token kill-switches.",
    href: "/articles/model-policy-governance-token-usage/",
    cta: "Read the governance model",
    accent: "--color-neural-500",
  },
  {
    metric: String(paperCount),
    unit: "papers shipped",
    label: "Research, delivered",
    detail:
      "arXiv-style write-ups on agentic root-cause analysis — externalized verification gates, bi-temporal incident memory, correlation-first blame propagation.",
    href: "/debug-agent/#papers",
    cta: "Read the papers",
    accent: "--color-complement-500",
  },
  {
    metric: "Weekly",
    unit: "auto-PRs",
    label: "The blog maintains itself",
    detail:
      "A Claude agent diffs three repos every Monday and opens article create/update/retire PRs, which I review and merge. It keeps the writing close to the code.",
    href: "/about/",
    cta: "How this blog ships",
    accent: "--color-neural-500",
  },
  {
    metric: "2022",
    unit: "→ today",
    label: "In production",
    detail:
      "Running live on a 2-node K3s cluster (on-prem + Hetzner CX43), joined over a Tailscale mesh and fronted by Cloudflare. Four phases, multi-year.",
    href: "/architecture/",
    cta: "See the architecture",
    accent: "--color-complement-500",
  },
];
---

<MainLayout
  title="Impact | BlueRobin"
  description="Measured outcomes from BlueRobin: 95% latency reduction (60s→3s), 20× ingestion throughput, a €50/month whole-platform cost ceiling, 5 shipped research papers, and a self-maintaining content pipeline. Proof of delivery, not just architecture."
>
  <!-- Breadcrumb -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <a href="/" class="text-sm text-ink-muted hover:text-neural-400 transition-colors">← All projects</a>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: var(--gradient-mesh-light);">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-neural-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-complement-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1.2s;"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10 sm:pt-24 text-center animate-entry">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-7" style="background: var(--color-neural-alpha-10); border: 1px solid var(--color-neural-alpha-20); color: var(--color-neural-400);">
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--color-complement-400);"></span>
        Selected results
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mb-5 leading-tight tracking-tight">
        <span class="title-blue">Outcomes,</span> <span class="title-warm">measured.</span>
      </h1>
      <p class="text-lg text-ink-muted max-w-2xl mx-auto">
        A few results from running BlueRobin in production. Each number links to the
        write-up explaining how it was built and measured — the reasoning matters more
        than the figure.
      </p>
    </div>
  </section>

  <!-- Metric grid -->
  <section class="relative py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {metrics.map((m, i) => (
          <a
            href={m.href}
            class={`impact-card glass-card group relative flex flex-col p-7 animate-entry-delay-${(i % 3) + 1}`}
          >
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-5xl font-display font-bold tracking-tight" style={`color: var(${m.accent});`}>{m.metric}</span>
              <span class="text-sm font-medium text-ink-subtle">{m.unit}</span>
            </div>
            <h2 class="text-base font-display font-semibold text-ink mb-2">{m.label}</h2>
            <p class="text-sm text-ink-muted leading-relaxed mb-5">{m.detail}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-medium" style={`color: var(${m.accent});`}>
              {m.cta}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it ships / proof strip -->
  <section class="relative py-12 sm:py-16" style="background: var(--gradient-mesh-light);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-display font-semibold title-blue mb-3">It runs in production</h2>
        <p class="text-ink-muted max-w-2xl mx-auto">
          BlueRobin has been live for a few years now. {articleCount}+ articles and {paperCount} papers
          document how it works — and you're welcome to look around.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href="https://web.bluerobin.io" class="glass-card p-6 group" target="_blank" rel="noopener noreferrer">
          <h3 class="font-display font-semibold text-ink mb-1.5">Try the live system →</h3>
          <p class="text-sm text-ink-muted">The Archives app, running on the cluster at <span class="font-mono text-xs">web.bluerobin.io</span> (login required).</p>
        </a>
        <a href="/debug-agent/#papers" class="glass-card p-6 group">
          <h3 class="font-display font-semibold text-ink mb-1.5">Read the research →</h3>
          <p class="text-sm text-ink-muted">{paperCount} arXiv-style papers on agentic RCA, with honest threats-to-validity.</p>
        </a>
        <a href="/about/" class="glass-card p-6 group">
          <h3 class="font-display font-semibold text-ink mb-1.5">See how it self-updates →</h3>
          <p class="text-sm text-ink-muted">A weekly Claude agent keeps the blog in sync with the codebase via human-gated PRs.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Director's lens CTA -->
  <section class="relative py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-display font-semibold text-ink mb-4">Why a homelab?</h2>
      <p class="text-ink-muted mb-8">
        It keeps me close to the work I ask my teams to do — explicit contracts, observable
        systems, honest cost trade-offs, and delivery you can measure.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/leadership/" class="btn-primary">Leadership notes</a>
        <a href="/" class="btn-secondary">Explore the projects</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .impact-card {
    transition: transform 0.3s var(--ease-smooth), box-shadow 0.3s var(--ease-smooth), border-color 0.3s var(--ease-smooth);
  }
  .impact-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-neural-alpha-20);
    box-shadow: var(--shadow-card-premium);
  }
</style>
