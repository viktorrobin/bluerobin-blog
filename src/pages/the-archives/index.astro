  {
    name: "Health agent",
    role: "Extracts biomarkers, providers, prescriptions, and appointments, then plots the values on a timeline.",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    tools: ["Biomarker timeline", "Provider linking", "Structured medical schema"],
  },
  {
    name: "Tax agent",
    role: "Gathers tax-relevant documents, figures, and deductions across the year — so filing season is a query, not a shoebox.",
