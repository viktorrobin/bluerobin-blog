// The agent lineup — specialists the user interacts with, plus the core
// shared-intelligence agents that read, connect, and enrich everything behind them.
const specialistAgents = [
  {
    name: "Retrieval agent",
    role: "Answers questions across your whole archive in plain English, citing the exact source paragraphs it used.",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
    tools: ["8-model embeddings", "Reciprocal Rank Fusion", "Graph traversal", "Local LLM"],
  },
  {
    name: "Finance agent",
    role: "Pulls transactions, merchants, amounts, and line items out of receipts and statements into a single spend view.",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>`,
    tools: ["Transaction schema", "Merchant resolution", "Spend dashboard"],
