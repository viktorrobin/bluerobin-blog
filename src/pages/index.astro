---

<MainLayout title="The BlueRobin Project" description="A homelab journey from medical document search to production AI">
  <!-- Hero Section -->
  <section class="relative overflow-hidden" style="background: var(--gradient-mesh);">
    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-neural-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-aurora-500/8 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-quantum-500/6 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
      <div class="text-center mb-12 animate-entry">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-slate-900 mb-6">
          <span class="text-transparent bg-clip-text" style="background-image: var(--gradient-signature);">The BlueRobin Project</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-slate-600 max-w-4xl mx-auto mb-6">
          An AI-powered personal document archive that transforms how you organize, 
          search, and understand your documents.
        </p>
        
        <p class="text-base text-slate-500 max-w-3xl mx-auto mb-10">
          From homelab experiment to production-ready system — documenting every step of building 
          a modern cloud-native application with <strong class="text-neural-600">.NET</strong>, 
          <strong class="text-quantum-600">Kubernetes</strong>, and 
          <strong class="text-aurora-600">AI/ML</strong>.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/architecture/" class="btn-primary">
            Architecture
          </a>
          <a href="/articles/" class="btn-secondary">
            All Articles
          </a>
        </div>
      </div>

      <!-- Feature Bento Grid — Apple-style dark cards with gradient accents -->
      <div class="bento-grid max-w-5xl mx-auto animate-entry-delay-1">
        <!-- Row 1: Two large feature cards -->
        <div class="bento-card bento-lg bento-neural">
          <div class="bento-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
          </div>
          <h3>Semantic Search</h3>
          <p>Find documents by meaning, not keywords. Multi-model RAG with 8 embedding models and reciprocal rank fusion.</p>
        </div>
        <div class="bento-card bento-lg bento-signature">
          <div class="bento-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8M10 9H8"/></svg>
          </div>
          <h3>AI-Powered OCR</h3>
          <p>Docling preserves document structure — tables, headings, and layout. Self-hosted, no cloud dependencies.</p>
        </div>

        <!-- Row 2: Three medium cards -->
        <div class="bento-card bento-aurora">
          <div class="bento-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Per-User Encryption</h3>
          <p>Isolated MinIO buckets with dedicated KES keys per user.</p>
        </div>
        <div class="bento-card bento-glow">
          <div class="bento-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
          </div>
          <h3>Event-Driven</h3>
          <p>NATS JetStream for async processing with real-time updates.</p>
        </div>
        <div class="bento-card bento-quantum">
          <div class="bento-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="M6.5 7.5 10 10M17.5 7.5 14 10M6.5 16.5 10 14M17.5 16.5 14 14"/></svg>
          </div>
          <h3>Knowledge Graph</h3>
          <p>FalkorDB links entities across your entire archive.</p>
        </div>

        <!-- Row 3: Full-width card -->
        <div class="bento-card bento-full bento-slate">
          <div class="bento-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <div>
            <h3>Self-Hosted on a Homelab K3s Cluster</h3>
            <p>Everything runs locally — Ollama for AI, Flux for GitOps, Linkerd for mTLS. Your data never leaves your hardware.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture & Tech Stack Section -->
  <section class="py-16" style="background: var(--glass-white-30); backdrop-filter: var(--blur-sm);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-display font-semibold text-slate-900 mb-4">
          System Architecture
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto mb-8">
          A cloud-native document intelligence platform built on DDD principles with event-driven microservices.
        </p>

        <!-- Tech Stack Pills -->
        <div class="flex flex-wrap justify-center gap-3 animate-entry-delay-2">
          {techStack.map((tech) => (
            <span class="tech-pill">
              <Fragment set:html={tech.icon} />
              {tech.name}
            </span>
          ))}
        </div>
      </div>
      
      <!-- Architecture Diagram with logos and gradient cards -->
      <div class="glass-card p-8 max-w-4xl mx-auto animate-entry-delay-3">
        <div class="flex flex-col gap-2 text-center text-sm">
          
          <!-- Layer: Frontend -->
          <div class="arch-layer-label arch-label-neural">Frontend</div>
