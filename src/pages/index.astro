---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, DIFFICULTIES, SERIES } from "@/config";

// Get all published posts, sorted by date
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured posts
const featuredPosts = sortedPosts.filter((post) => post.data.featured);

// Recent posts (excluding featured)
const recentPosts = sortedPosts.filter((post) => !post.data.featured).slice(0, 6);

// AI posts for showcase
const aiPosts = sortedPosts.filter((post) => post.data.category === "ai").slice(0, 3);

const formatDate = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

// Tech stack icons
const techStack = [
  { name: ".NET 10", color: "bg-slate-100 text-slate-700" },
  { name: "Blazor Server", color: "bg-slate-100 text-slate-700" },
  { name: "NATS JetStream", color: "bg-slate-100 text-slate-700" },
  { name: "PostgreSQL", color: "bg-slate-100 text-slate-700" },
  { name: "Qdrant", color: "bg-slate-100 text-slate-700" },
  { name: "MinIO", color: "bg-slate-100 text-slate-700" },
  { name: "Ollama", color: "bg-slate-100 text-slate-700" },
  { name: "Kubernetes", color: "bg-slate-100 text-slate-700" },
];
---

<MainLayout title="The BlueRobin Project" description="A homelab journey from medical document search to production AI">
  <!-- Hero Section with Project Overview -->
  <section class="relative overflow-hidden" style="background: var(--gradient-mesh);">
    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-neural-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-aurora-500/8 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-quantum-500/6 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32">
      <div class="text-center mb-16">
        
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-slate-900 mb-6">
          <span class="text-transparent bg-clip-text" style="background-image: var(--gradient-signature);">The BlueRobin Project</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-slate-600 max-w-4xl mx-auto mb-6">
          An AI-powered personal document archive that transforms how you organize, 
          search, and understand your documents.
        </p>
        
        <p class="text-base text-slate-500 max-w-3xl mx-auto mb-10">
          From homelab experiment to production-ready system — documenting every step of building 
          a modern cloud-native application with <strong class="text-neural-600">.NET</strong>, 
          <strong class="text-quantum-600">Kubernetes</strong>, and 
          <strong class="text-aurora-600">AI/ML</strong>.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/architecture/" class="btn-primary">
            Architecture
          </a>
          <a href="/articles/" class="btn-secondary">
            All Articles
          </a>
        </div>
      </div>

      <!-- Tech Stack Pills -->
      <div class="flex flex-wrap justify-center gap-3 mb-16">
        {techStack.map((tech) => (
          <span class={`inline-flex items-center px-4 py-2 rounded-full text-sm font-medium ${tech.color} border border-slate-200/50`}>
            {tech.name}
          </span>
        ))}
      </div>

      <!-- Key Features / Pain Points Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="glass-card p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Semantic Search</h3>
          <p class="text-slate-500 text-sm">
            Find documents by meaning, not just keywords. RAG-powered Q&A over your entire archive.
          </p>
        </div>
        <div class="glass-card p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">AI-Powered OCR</h3>
          <p class="text-slate-500 text-sm">
            Docling extracts text with layout preservation. Tables, headings, and structure intact.
          </p>
        </div>
        <div class="glass-card p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Per-User Encryption</h3>
          <p class="text-slate-500 text-sm">
            Every user gets isolated storage with dedicated KMS keys. Zero-trust architecture.
          </p>
        </div>
        <div class="glass-card p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Event-Driven</h3>
          <p class="text-slate-500 text-sm">
            NATS JetStream for reliable async processing. Real-time UI updates without polling.
          </p>
        </div>
        <div class="glass-card p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Knowledge Graph</h3>
          <p class="text-slate-500 text-sm">
            FalkorDB connects entities across documents. Discover relationships automatically.
          </p>
        </div>
        <div class="glass-card p-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Self-Hosted</h3>
          <p class="text-slate-500 text-sm">
            Runs on a homelab K3s cluster. Local AI with Ollama. Your data stays yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture Diagram Section -->
  <section class="py-16" style="background: var(--glass-white-30); backdrop-filter: blur(8px);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-display font-bold text-slate-900 mb-4">
          System Architecture
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          A cloud-native document intelligence platform built on DDD principles with event-driven microservices.
        </p>
      </div>
      
      <!-- Simplified Architecture Diagram using Divs -->
      <div class="glass-card p-8 max-w-4xl mx-auto">
        <div class="grid grid-cols-3 gap-4 text-center text-sm">
          <!-- Frontend Row -->
          <div class="col-span-3 mb-4">
            <div class="inline-flex items-center gap-4 p-4 rounded-xl bg-slate-100 border border-slate-200">
              <div class="text-left">
                <div class="font-semibold text-slate-900">Blazor Server</div>
                <div class="text-xs text-slate-600">Interactive UI with real-time updates</div>
              </div>
            </div>
          </div>
          
          <!-- API & Workers Row -->
          <div class="col-span-3 grid grid-cols-2 gap-4 mb-4">
            <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
              <div class="font-semibold text-slate-900">FastEndpoints API</div>
              <div class="text-xs text-slate-600">REST + OpenAPI</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
              <div class="font-semibold text-slate-900">Background Workers</div>
              <div class="text-xs text-slate-600">OCR, Embeddings, NER</div>
            </div>
          </div>
          
          <!-- Messaging Row -->
          <div class="col-span-3 mb-4">
            <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
              <span class="font-semibold text-slate-900">NATS JetStream</span>
              <span class="text-xs text-slate-600 ml-2">Event-Driven Messaging</span>
            </div>
          </div>
          
          <!-- Data Layer Row -->
          <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
            <div class="font-semibold text-slate-900">PostgreSQL</div>
            <div class="text-xs text-slate-600">Metadata</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
            <div class="font-semibold text-slate-900">Qdrant</div>
            <div class="text-xs text-slate-600">Vectors</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-100 border border-slate-200">
            <div class="font-semibold text-slate-900">MinIO</div>
            <div class="text-xs text-slate-600">Documents</div>
          </div>
          
          <!-- AI Services Row -->
          <div class="col-span-3 mt-4 grid grid-cols-3 gap-4">
            <div class="p-3 rounded-xl bg-slate-100 border border-slate-200">
              <div class="font-semibold text-slate-900 text-xs">Ollama</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-100 border border-slate-200">
              <div class="font-semibold text-slate-900 text-xs">Docling OCR</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-100 border border-slate-200">
              <div class="font-semibold text-slate-900 text-xs">spaCy NER</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Series Overview -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-display font-bold text-slate-900 mb-8">
      Article Series
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {Object.entries(SERIES).map(([key, series]) => (
        <a href={`/tags/${key}/`} class="glass-card p-6 hover:shadow-lg transition-all hover:-translate-y-1">
          <h3 class="font-semibold text-slate-900 mb-2">{series.title}</h3>
          <p class="text-sm text-slate-600">{series.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-2xl font-display font-bold text-slate-900">
        Recent Articles
      </h2>
      <a href="/articles/" class="text-neural-600 hover:underline">
        View all →
      </a>
    </div>

    {sortedPosts.length === 0 ? (
      <div class="glass-card p-12 text-center">
        <p class="text-slate-600 text-lg">
          Articles coming soon. The first article in the DDD series is being prepared.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.slice(0, 6).map((post) => {
          const categoryMeta = CATEGORIES[post.data.category];
          const difficultyMeta = DIFFICULTIES[post.data.difficulty];
          return (
            <article class="article-card">
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs px-2 py-0.5 rounded-full category-${post.data.category}`}>
                  {post.data.category}
                </span>
                <span class={`text-xs px-2 py-0.5 rounded-full difficulty-${post.data.difficulty}`}>
                  {difficultyMeta.label}
                </span>
              </div>
              <a href={`/articles/${post.slug}/`}>
                <h2>{post.data.title}</h2>
              </a>
              <p>{post.data.description}</p>
              <div class="mt-4 flex items-center justify-between text-sm text-slate-500">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                {post.data.readTime && <span>{post.data.readTime}</span>}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- Quick Links by Category -->
  <section class="py-16" style="background: var(--glass-white-40); backdrop-filter: blur(8px);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-display font-bold text-slate-900 mb-8">
        Browse by Category
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {Object.entries(CATEGORIES).map(([key, category]) => (
          <a href={`/${key}/`} class="glass-card p-6 hover:shadow-lg transition-all hover:-translate-y-1">
            <h3 class="font-semibold text-slate-900 mb-1">{category.title}</h3>
            <p class="text-sm text-slate-600">{category.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
