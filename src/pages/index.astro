---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { iconSymbols } from "@/lib/brandIcons";

// Brand/glyph icons used by the platform-architecture SVG below.
const archIconIds = ["cloudflare", "dotnet", "ollama", "postgresql", "natsdotio", "qdrant", "graph", "grafana", "bug", "mcp", "github", "ntfy"];

// Live counts per project to show on each tile
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const archivesCount = allPosts.filter((p) => p.data.project === "archives").length;
const debugAgentCount = allPosts.filter((p) => p.data.project === "debug-agent").length;

const projects = [
  {
    href: "/the-archives/",
    kind: "Homelab project",
    kindBg: "--color-neural-alpha-10",
    kindBorder: "--color-neural-alpha-20",
    label: "The Archives",
    tagline: "A self-hosted team of document AI agents",
    description:
      "Upload any document and a team of AI agents takes over — triaging, then routing to specialists for retrieval, finance, health, and tax. Behind them: ensemble entity extraction, a knowledge graph, and multi-model vector search, running end-to-end on a homelab K3s cluster.",
    cta: "Explore the Archives",
    count: archivesCount,
    countLabel: "articles",
    accentVar: "--color-neural-400",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>`,
  },
  {
    href: "/debug-agent/",
    kind: "Research project",
    kindBg: "--color-complement-alpha-10",
    kindBorder: "--color-complement-alpha-20",
    label: "The Debug Agent",
    tagline: "Autonomous, graph-grounded root-cause analysis",
    description:
      "When production breaks, an LLM agent investigates — traversing a FalkorDB world-model, ranking suspects with correlation-first scoring, and opening a pull request only when hard evidence supports it. Research-grade RCA at homelab cost.",
    cta: "Explore the Debug Agent",
    count: debugAgentCount,
    countLabel: "papers",
    accentVar: "--color-complement-300",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/><circle cx="11" cy="11" r="2.2" fill="currentColor" stroke="none"/></svg>`,
  },
];
---

<MainLayout
  title="BlueRobin — Two homelab projects"
  description="The work of Victor Robin: The Archives, a self-hosted document-intelligence platform, and The Debug Agent, an autonomous graph-grounded root-cause-analysis agent. Choose an area to explore."
>
  <!-- Intro -->
  <section class="relative overflow-hidden" style="background: var(--gradient-mesh-light);">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-neural-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-complement-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1.2s;"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-10 sm:pt-28 text-center animate-entry">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-8" style="background: var(--color-neural-alpha-10); border: 1px solid var(--color-neural-alpha-20); color: var(--color-neural-400);">
        <img src="/bluerobin-logo.png" alt="" class="w-4 h-4 object-contain" />
        BlueRobin · a homelab by Victor Robin
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mb-6 leading-tight tracking-tight">
        <span class="title-blue">Two projects,</span><br />
        <span class="title-warm">one homelab.</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto">
        I build production-grade AI on self-hosted infrastructure — and write about it.
        One is the <strong class="font-semibold text-slate-800">team of agents</strong> that runs my documents;
        the other is the <strong class="font-semibold text-slate-800">research</strong> behind making the platform debug itself.
      </p>

      <p class="mt-5 text-base text-slate-500 max-w-2xl mx-auto">
        Built and run by <strong class="font-medium text-slate-700">Victor Robin</strong>, an engineering
        director working across India &amp; Berlin. BlueRobin is my homelab — where I stay close to the
        same disciplines I lead with at work, at a scale I can hold in my head.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/impact/" class="btn-primary">See the impact</a>
        <a href="/about/#request-access" class="btn-secondary">Work with me</a>
      </div>
    </div>
  </section>

  <!-- Project chooser -->
  <section class="relative py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {projects.map((p, i) => (
          <a
            href={p.href}
            class={`project-tile glass-card group relative flex flex-col overflow-hidden p-8 animate-entry-delay-${i + 1}`}
            style={`--tile-ring: var(${p.kindBorder});`}
          >
            <!-- soft corner glow, accent-tinted -->
            <div class="pointer-events-none absolute -top-16 -right-16 w-40 h-40 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" style={`background: var(${p.kindBg});`}></div>

            <div class="relative flex items-center justify-between mb-6">
              <span
                class="inline-flex items-center justify-center w-12 h-12 rounded-2xl shrink-0"
                style={`background: var(${p.kindBg}); color: var(${p.accentVar}); border: 1px solid var(${p.kindBorder});`}
                set:html={p.icon}
              />
              <span class="inline-flex items-center gap-2 text-xs font-medium text-slate-500">
                <span class="w-1.5 h-1.5 rounded-full" style={`background: var(${p.accentVar});`}></span>
                {p.kind}
              </span>
            </div>

            <h2 class="relative text-2xl sm:text-3xl font-display font-semibold text-slate-900 mb-1.5">
              {p.label}
            </h2>
            <p class="relative text-sm font-medium mb-4" style={`color: var(${p.accentVar});`}>
              {p.tagline}
            </p>

            <p class="relative text-slate-600 leading-relaxed mb-6">
              {p.description}
            </p>

            <div class="relative mt-auto flex items-center justify-between border-t border-slate-900/5 pt-5">
              <span class="inline-flex items-center gap-2 font-medium text-slate-900 group-hover:gap-3 transition-all">
                {p.cta}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <span class="text-xs text-slate-500 px-2.5 py-1 rounded-full bg-slate-900/5">
                {p.count > 0 ? `${p.count} ${p.countLabel}` : "coming soon"}
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- secondary links -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-500">
        <a href="/impact/" class="hover:text-neural-400 transition-colors">Impact</a>
        <span class="text-slate-300" aria-hidden="true">·</span>
        <a href="/leadership/" class="hover:text-neural-400 transition-colors">Leadership</a>
        <span class="text-slate-300" aria-hidden="true">·</span>
        <a href="/about/" class="hover:text-neural-400 transition-colors">About</a>
      </div>

      <!-- About teaser -->
      <a href="/about/" class="group mt-8 flex items-center gap-4 max-w-2xl mx-auto glass-card p-5 text-left transition-transform hover:-translate-y-0.5">
        <img src="/bluerobin-logo.png" alt="" class="w-10 h-10 object-contain shrink-0" />
        <div class="min-w-0">
          <p class="text-sm font-semibold text-slate-900">Victor Robin, Ph.D. — Director of Engineering</p>
          <p class="text-sm text-slate-600 truncate">France → Sweden → UK → India · engineering leadership · production AI on a €50/mo homelab</p>
        </div>
        <span class="ml-auto text-neural-400 shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <!-- Platform architecture: how both projects share one homelab + cloud -->
  <section class="relative py-12 sm:py-16" style="background: var(--gradient-mesh-light);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-display font-semibold title-blue mb-3">One platform, two projects</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          The Archives and the Debug Agent run on the same homelab K3s cluster — one on-prem node plus a Hetzner cloud worker, joined over a Tailscale mesh and fronted by Cloudflare. Production is the only in-cluster environment (ADR-034).
        </p>
      </div>
      <div class="glass-card p-4 sm:p-6 overflow-x-auto">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 734" role="img" style="width:100%;height:auto;max-width:780px;margin:0 auto;display:block;" font-family="ui-sans-serif, -apple-system, system-ui, sans-serif">
<title>BlueRobin platform architecture — on-prem and cloud</title>
<desc>Zoned topology: users and external LLM APIs at top; a Cloudflare edge zone (DNS/WAF/Tunnel, R2 storage, AI Gateway); a Tailscale-meshed prod-only K3s cluster with an on-prem homelab node (Traefik/Authelia, the Archives agent platform with triage, retrieval, finance, health and tax agents, Ollama, and a data layer of PostgreSQL, NATS, Qdrant, FalkorDB plus an NAS registry) and a Hetzner CX43 cloud worker (cloudflared, LGTM observability, debug agent and RCA, MCP fleet, ARC runners, API/Web spillover); outputs to GitHub auto-PRs and ntfy alerts; a developer laptop runs off-cluster.</desc>
