<style>
  .project-tile {
    --tile-ring: var(--color-neural-alpha-20);
    transition: transform 0.3s var(--ease-smooth), box-shadow 0.3s var(--ease-smooth), border-color 0.3s var(--ease-smooth);
  }
  .project-tile:hover {
    transform: translateY(-4px);
    border-color: var(--tile-ring);
    box-shadow: var(--shadow-card-premium);
  }
</style>
