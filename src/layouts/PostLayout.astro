---
import BaseLayout from "./BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { CATEGORIES, DIFFICULTIES } from "@/config";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, difficulty, readTime, ogImage, toc, project, deprecated, deprecatedReason } = post.data;

const categoryMeta = CATEGORIES[category];
const difficultyMeta = DIFFICULTIES[difficulty];

// Project-aware navigation (Archives vs Debug Agent)
const isDebugAgent = project === "debug-agent";
const projectMeta = isDebugAgent
  ? { label: "Debug Agent", hubHref: "/debug-agent/", backLabel: "← Back to Debug Agent" }
  : { label: "The Archives", hubHref: "/the-archives/", backLabel: "← Back to Articles" };

// Format dates
const formatDate = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${title} | BlueRobin Tech Blog`} description={description} ogImage={ogImage}>
  <Header />
  
  <main class="flex-1">
    <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Article Header -->
      <header class="mb-8">
        <!-- Breadcrumb -->
        <nav class="text-sm text-slate-600 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-neural-400 transition-colors">Home</a>
          <span class="mx-2 text-slate-400">/</span>
          <a href={projectMeta.hubHref} class="hover:text-neural-400 transition-colors">{projectMeta.label}</a>
          <span class="mx-2 text-slate-400">/</span>
          <a href={`/${category}/`} class="hover:text-neural-400 transition-colors capitalize">{category}</a>
        </nav>

        <!-- Category & Difficulty badges -->
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium category-${category}`}>
            {categoryMeta.title}
          </span>
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium difficulty-${difficulty}`}>
            {difficultyMeta.label}
          </span>
          {readTime && (
            <span class="text-sm text-slate-500">
              {readTime}
            </span>
          )}
        </div>

        <!-- Title -->
        <h1 class={`text-2xl sm:text-3xl lg:text-4xl font-display font-semibold mb-4 leading-tight ${isDebugAgent ? "title-warm" : "title-blue"}`}>
          {title}
        </h1>

        <!-- Description -->
        <p class="text-lg text-slate-600 mb-6">
          {description}
        </p>

        <!-- Meta info -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 mb-6">
          <span>By {author}</span>
          <span>•</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <>
              <span>•</span>
              <span>Updated: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
            </>
          )}
        </div>
      </header>

      <!-- Deprecation notice (frontmatter: deprecated) -->
      {deprecated && (
        <div class="mb-8 flex gap-3 rounded-lg px-4 py-3.5 text-sm text-slate-700" style="background: var(--color-glow-alpha-10); border: 1px solid var(--color-glow-alpha-20);" role="note">
          <svg class="w-5 h-5 shrink-0 mt-0.5" style="color: #BA7517;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span><strong class="font-semibold text-slate-900">Deprecated.</strong> {deprecatedReason || "This article documents an approach BlueRobin has since replaced. It is kept for historical context."}</span>
        </div>
      )}

      <!-- Article Content -->
      <div class="prose prose-slate prose-headings:font-display prose-code:before:content-none prose-code:after:content-none max-w-none">
        <slot />
      </div>

      <!-- Article Footer -->
        <footer class="mt-12 pt-8 border-t border-slate-900/10">
        <div class="flex justify-between items-center">
          <a href={projectMeta.hubHref} class="btn-secondary">
            {projectMeta.backLabel}
          </a>
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</BaseLayout>
