# Security headers for the Cloudflare Workers static-assets deploy.
# (nginx.conf headers only apply to the legacy Docker/nginx path, NOT production.)
# Cloudflare serves files in /public verbatim, so this _headers file is honored.
#
# NOTE: script-src/style-src keep 'unsafe-inline' because the site uses inline
# styles and Astro/Mermaid inline bootstrapping. Once fonts are self-hosted and
# inline styles are tokenized (Phase-2 backlog), tighten this CSP.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
