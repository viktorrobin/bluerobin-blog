# New Relic Browser Agent (Real User Monitoring)
# All three vars are required for the browser agent to initialize.
# Keys are PUBLIC (client-visible) — this is intentional for browser agents.
# Get these from: NR One → Add data → Browser → (your app) → Application settings
PUBLIC_NR_ACCOUNT_ID=
PUBLIC_NR_BROWSER_LICENSE_KEY=
PUBLIC_NR_BROWSER_APP_ID=
